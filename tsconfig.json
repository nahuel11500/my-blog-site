{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // The Worker has its own tsconfig: workers-types and the DOM lib both declare
  // Request/Response, so they cannot share a program.
  "exclude": ["dist", "worker"],
  "compilerOptions": {
    "strictNullChecks": true
  }
}
