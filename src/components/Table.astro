---
interface Props {
	columns?: string[];
	rows?: string[][];
	striped?: boolean;
	compact?: boolean;
}

const { columns = [], rows = [], striped = false, compact = false } = Astro.props;
---

<div class="table-container">
	<table class="custom-table">
		<thead class="table-header">
			<tr>
				{
					columns.map((col) => (
						<th class:list={['table-header-cell', { compact }]}>{col}</th>
					))
				}
			</tr>
		</thead>
		<tbody class="table-body">
			{
				rows.map((row, index) => (
					<tr
						class:list={[
							'table-row',
							{ 'striped-row': striped && index % 2 === 1, compact },
						]}
					>
						{row.map((cell) => <td class:list={['table-cell', { compact }]}>{cell}</td>)}
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	/* Plain rules between rows; colors from the theme in global.css. */
	.table-container {
		margin: 1.75rem 0;
		overflow-x: auto;
	}

	.custom-table {
		width: 100%;
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}

	.table-header-cell {
		padding: 0.5rem 1.25rem 0.5rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.85rem;
		font-weight: 400;
		text-align: left;
		white-space: nowrap;
	}

	.table-row {
		border-bottom: 1px solid var(--line);
	}

	.table-cell {
		padding: 0.55rem 1.25rem 0.55rem 0;
		color: var(--text);
		font-size: 0.9rem;
		line-height: 1.5;
		white-space: nowrap;
	}

	.table-cell:first-child {
		color: var(--strong);
		font-family: var(--mono);
		font-size: 0.82rem;
	}

	.compact {
		padding-block: 0.35rem;
	}
</style>
