---
// A screenshot of the app in a window frame: `<name>-800.webp` and `<name>.webp` (1600 px wide)
// under /media/recouvrance/, opened full size on click.
import { MEDIA } from '../../lib/recouvrance';

interface Props {
	name: string;
	alt: string;
	eager?: boolean;
	sizes?: string;
}

const { name, alt, eager = false, sizes = '(max-width: 900px) 100vw, 680px' } = Astro.props;
---

<figure class="window">
	<a href={`${MEDIA}/${name}.webp`}>
		<img
			src={`${MEDIA}/${name}-800.webp`}
			srcset={`${MEDIA}/${name}-800.webp 800w, ${MEDIA}/${name}.webp 1600w`}
			sizes={sizes}
			width="1600"
			height="981"
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : undefined}
			decoding="async"
			alt={alt}
		/>
	</a>
</figure>
