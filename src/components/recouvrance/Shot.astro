---
// A screenshot of the app in a window frame: `<name>-800.webp` and `<name>.webp` (1600 px wide)
// under /media/recouvrance/, opened full size on click. The tour's rows use crops of the page
// without the sidebar (16:10), so the text stays readable at half size.
import { MEDIA } from '../../lib/recouvrance';

interface Props {
	name: string;
	alt: string;
	eager?: boolean;
	sizes?: string;
	/** The height of the 1600 px wide image: 981 for the whole window, 1000 for a crop of the page. */
	height?: number;
	/** For an animation: a still image, shown on reduced motion and by the Pause button. */
	still?: string;
}

const { name, alt, eager = false, sizes = '(max-width: 900px) 100vw, 680px', height = 981, still } = Astro.props;
---

<figure class="window" data-still={still && `${MEDIA}/${still}.webp`}>
	<a href={`${MEDIA}/${name}.webp`}>
		<picture>
		{still && <source media="(prefers-reduced-motion: reduce)" srcset={`${MEDIA}/${still}.webp`} />}
		<img
			src={`${MEDIA}/${name}-800.webp`}
			srcset={`${MEDIA}/${name}-800.webp 800w, ${MEDIA}/${name}.webp 1600w`}
			sizes={sizes}
			width="1600"
			height={height}
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : undefined}
			decoding="async"
			alt={alt}
		/>
		</picture>
	</a>
</figure>
