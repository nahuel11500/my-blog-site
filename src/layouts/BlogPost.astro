---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { ogImage?: string; slug?: string };

const { title, description, pubDate, updatedDate, ogImage, slug } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage={ogImage} />
		<style>
			.prose {
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			/* Invisible, but laid out: browsers skip lazy images that are display:none. */
			.read-marker {
				display: block;
				width: 1px;
				height: 1px;
				opacity: 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					{
						/*
						 * Read counter: browsers fetch a lazy image only when the reader
						 * scrolls near it, so this request means "reached the end of the
						 * post". See worker/index.ts and /privacy/.
						 */
						slug && (
							<img
								class="read-marker"
								src={`/read/${slug}/`}
								alt=""
								width="1"
								height="1"
								loading="lazy"
								decoding="async"
								aria-hidden="true"
							/>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
