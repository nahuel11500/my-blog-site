---
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Thinking from '../components/Thinking.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Site from '../layouts/Site.astro';
import { getPosts } from '../lib/posts';
import { projects } from '../lib/projects';

const posts = await getPosts();
const latest = posts.slice(0, 5);
---

<Site title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section>
		<h1>Nahuel Canavy</h1>
		<p class="intro">
			Platform engineer. I build the infrastructure engineering and ML teams run on, and write
			about Kubernetes, Linux internals, SRE, and AI agents working on real clusters.
		</p>
		<p class="links">
			<a href="/about/">About</a>
			<a href="https://github.com/nahuel11500" rel="me">GitHub</a>
			<a href="https://www.linkedin.com/in/nahuel-canavy-159109234/" rel="me">LinkedIn</a>
			<a href="/rss.xml">RSS</a>
		</p>
		<Thinking />
	</section>

	<section aria-labelledby="writing">
		<h2 class="section-title" id="writing">Writing</h2>
		<PostList posts={latest} level="h3" />
		{posts.length > latest.length && <a class="more" href="/blog/">All {posts.length} posts</a>}
	</section>

	<section aria-labelledby="projects">
		<h2 class="section-title" id="projects">Projects</h2>
		{projects.map((p) => <ProjectCard project={p} level="h3" />)}
	</section>
</Site>

<style>
	section + section {
		margin-top: 3.5rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
		margin: 0.75rem 0 1.25rem;
		font-size: 0.875rem;
	}
	.links a {
		padding-block: 0.25rem;
		color: var(--muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--strong);
	}
</style>
