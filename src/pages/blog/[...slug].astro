---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { type Post, getPosts, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	// Newest first, so the older post is the next one in the list.
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, older: posts[i + 1], newer: posts[i - 1] },
	}));
}

interface Props {
	post: Post;
	older?: Post;
	newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const link = (p?: Post) => p && { href: `/blog/${p.id}/`, title: p.data.title };
---

<BlogPost
	{...post.data}
	ogImage={`/og/${post.id}.png`}
	slug={post.id}
	minutes={readingMinutes(post)}
	older={link(older)}
	newer={link(newer)}
>
	<Content />
</BlogPost>
