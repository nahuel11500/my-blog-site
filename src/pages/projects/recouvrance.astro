---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { latestReleases } from '../../lib/releases';

const REPO = 'nahuel11500/recouvrance';
const GITHUB = `https://github.com/${REPO}`;
const DOCS = `${GITHUB}/tree/main/docs`;
const INSTALL = `curl --proto '=https' --tlsv1.2 -LsSf ${GITHUB}/releases/latest/download/recouvrance-installer.sh | sh`;
const MEDIA = '/media/recouvrance';

const releases = await latestReleases(REPO);
const version = releases[0]?.tag;

const title = 'Recouvrance: a Kubernetes client for you and your agents';
const description =
	'A fast, native Kubernetes desktop client in Rust, with a local MCP server so AI agents work on your clusters under rules you set.';

const shots = [
	{
		img: 'problems',
		title: "What's broken, across clusters",
		text: 'Crash loops, pending pods, unavailable workloads, NotReady nodes and failed jobs, on one page for every cluster you have open.',
		alt: 'The Problems page listing broken workloads across clusters',
	},
	{
		img: 'diagnosis',
		title: 'Why it is broken',
		text: 'Every broken pod or workload gets a diagnosis: crash output and exit code, scheduling, image pulls, probes, volumes.',
		alt: 'A crash-looping pod with its diagnosis and last output',
	},
	{
		img: 'logs',
		title: 'Logs across pods',
		text: 'Every pod of a deployment merged in time order, with levels, a timeline, regex search and readable JSON.',
		alt: 'Logs of every pod of a deployment, merged, with levels and a timeline',
	},
	{
		img: 'command-palette',
		title: 'Ctrl+K to anything',
		text: 'Resources, pages, contexts and objects, across clusters. Filter tables with expressions like <code>status:Running restarts&gt;3</code>.',
		alt: 'The command palette finding objects and pages',
	},
];

const features = [
	{ title: 'Several clusters at once', text: 'Merged tables with a Context column. Compare an object across clusters.' },
	{ title: 'Roll back anything', text: 'Deployments, StatefulSets and DaemonSets, with a diff and a server dry run.' },
	{ title: 'Helm, Flux, Argo CD', text: 'Upgrade with edited values, roll back, reconcile, suspend, sync and refresh.' },
	{ title: 'Access made clear', text: 'Who-can, the effective access of a ServiceAccount, short-lived kubeconfigs.' },
	{ title: 'Usage history', text: 'From Prometheus or VictoriaMetrics, found through the API server. Used vs requested.' },
	{ title: 'Shell, files, port-forwards', text: 'Exec, attach, file copy. Port-forwards are remembered and follow new pods.' },
];

const faq = [
	{
		q: 'Is it safe to let an agent work on my clusters?',
		a: 'Agents get only what their rules allow, and anything no rule matches is denied. <em>Ask me</em> rules wait for your approval in the window, every call is written to an audit log, and a kill switch cuts every agent off. Note that the read-only mode of the window is for you: agents follow their own rules, so give them Deny or Ask me rules for what they must not touch.',
	},
	{
		q: 'How is it different from k9s, Lens or Aptakube?',
		a: `It is a native app with no web view, it tells you why things are broken instead of only listing them, and it is built for agents to work on your clusters under rules, approvals and an audit log. There is a <a href="${GITHUB}/blob/main/docs/COMPARISON.md">feature-by-feature comparison</a> in the docs.`,
	},
	{
		q: 'Does it send data anywhere?',
		a: 'No telemetry, no analytics. It talks to your clusters, to the Prometheus or VictoriaMetrics you point it at, and to Anthropic only if you use the assistant.',
	},
	{
		q: 'Do I need Claude?',
		a: 'No. The client works on its own, and the MCP server works with any MCP client. The built-in assistant uses your Claude Code login, or an Anthropic API key.',
	},
	{
		q: 'Does it run on Windows?',
		a: 'Not yet. It runs on Linux (x86_64 and arm64) and macOS (Intel and Apple silicon).',
	},
	{
		q: 'Is it free?',
		a: 'Yes. It is open source, under the MIT or Apache-2.0 license, your choice.',
	},
	{
		q: 'Where does the name come from?',
		a: '<em>Recouvrance</em> is a schooner from Brest, a replica of an 1817 aviso: the fast ships that carried dispatches. In French, <em>recouvrer</em> means to recover.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage="/og/projects/recouvrance.png" />
	</head>
	<body>
		<Header />
		<main class="rv">
			<section class="hero">
				<img class="logo" src={`${MEDIA}/logo.svg`} alt="" width="88" height="88" />
				<p class="eyebrow">Recouvrance{version && <span> · {version}</span>}</p>
				<h1>Kubernetes for you and your agents.<br /><span>On your rules.</span></h1>
				<p class="lede">
					A fast, native desktop client for Kubernetes, written in Rust. Its local MCP server lets
					Claude Code and other agents work on your clusters under rules you set: allow, ask, or deny.
				</p>
				<pre class="install" aria-label="Install command"><code>{INSTALL}</code></pre>
				<p class="actions">
					<a class="button primary" href={GITHUB}>View on GitHub</a>
					<a class="button" href={`${GITHUB}/releases/latest`}>Downloads</a>
				</p>
				<p class="meta">Linux and macOS · Open source, MIT or Apache-2.0 · Starts read-only</p>
			</section>

			<div class="window">
				<video autoplay muted loop playsinline preload="metadata" poster={`${MEDIA}/tour-poster.webp`} width="1200" height="736">
					<source src={`${MEDIA}/tour.webm`} type="video/webm" />
					<source src={`${MEDIA}/tour.mp4`} type="video/mp4" />
				</video>
			</div>

			<section class="agents wrap">
				<div>
					<p class="kicker">Built for agents</p>
					<h2>Agents work on your clusters. You keep the rules.</h2>
					<p>
						While it runs, Recouvrance serves MCP on localhost. Connect Claude Code in one click, or
						any MCP client, and give each agent rules that read like Kubernetes RBAC, with an effect.
					</p>
					<ul class="checks">
						<li><strong>Approvals.</strong> An <em>Ask me</em> rule shows you the exact request in the window. <em>Always allow this</em> adds a narrow rule.</li>
						<li><strong>Audit log.</strong> Every call is logged, and a kill switch cuts every agent off at once.</li>
						<li><strong>Rules that expire.</strong> <em>Allow for 1h</em>, a rate limit per agent, and <em>Test access</em> to see which rule decides.</li>
						<li><strong>40+ tools.</strong> Logs, diffs, rollouts and rollbacks, port-forwards, debug containers, cordon and drain, <code>explain</code> and <code>can-i</code>.</li>
					</ul>
				</div>
				<figure class="rules">
					<table>
						<thead>
							<tr><th>Effect</th><th>Verbs</th><th>Resources</th><th>Namespaces</th><th>Contexts</th></tr>
						</thead>
						<tbody>
							<tr><td><span class="allow">Allow</span></td><td>get, list, logs</td><td>*</td><td>*</td><td>*</td></tr>
							<tr><td><span class="ask">Ask me</span></td><td>scale, restart</td><td>deployments</td><td>team-*</td><td>staging</td></tr>
							<tr><td><span class="deny">Deny</span></td><td>reveal</td><td>secrets</td><td>*</td><td>*</td></tr>
							<tr><td><span class="deny">Deny</span></td><td>delete, drain</td><td>*</td><td>*</td><td>prod-*</td></tr>
						</tbody>
					</table>
					<figcaption>Deny wins, then Ask me, then Allow. Anything no rule matches is denied.</figcaption>
				</figure>
				<aside class="story">
					<p>
						<strong>Why this exists.</strong> An agent's unreviewed change, merged through over-permissioned
						CI, took our production cluster down for six hours.
						<a href="/blog/first_production_incident_agent/">Read the post-mortem →</a>
					</p>
				</aside>
			</section>

			<section class="wrap">
				<p class="kicker">Tells you what is wrong</p>
				<h2>Everything you reach for, one click away</h2>
				<div class="shots">
					{
						shots.map((s) => (
							<article class="card shot">
								<a href={`${MEDIA}/${s.img}.webp`}>
									<img
										src={`${MEDIA}/${s.img}-800.webp`}
										srcset={`${MEDIA}/${s.img}-800.webp 800w, ${MEDIA}/${s.img}.webp 1600w`}
										sizes="(max-width: 760px) 100vw, 560px"
										width="1600"
										height="981"
										loading="lazy"
										decoding="async"
										alt={s.alt}
									/>
								</a>
								<h3>{s.title}</h3>
								<p set:html={s.text} />
							</article>
						))
					}
				</div>
				<div class="features">
					{
						features.map((f) => (
							<article class="card">
								<h3>{f.title}</h3>
								<p>{f.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="numbers">
				<div class="wrap">
					<p class="kicker">Native, no web view</p>
					<h2>Rust and gpui, the toolkit behind the Zed editor</h2>
					<dl>
						<div><dt>174 MB</dt><dd>peak memory listing 23,958 pods of a production cluster</dd></div>
						<div><dt>40+</dt><dd>MCP tools for agents, each checked against your rules</dd></div>
						<div><dt>0</dt><dd>telemetry or analytics calls</dd></div>
						<div><dt>0</dt><dd>lines of <code>unsafe</code> Rust: the crate forbids it</dd></div>
					</dl>
				</div>
			</section>

			<section class="wrap two">
				<div>
					<p class="kicker">Safe by default</p>
					<h2>It holds your credentials. It earns that.</h2>
				</div>
				<ul class="checks">
					<li><strong>Read-only until you say so.</strong> Every write shows its <code>kubectl</code> equivalent and asks first.</li>
					<li><strong>Dry run first.</strong> YAML edits and applies are checked by the API server before they land.</li>
					<li><strong>Protected contexts.</strong> Production waits a few seconds, or makes you type its name.</li>
					<li><strong>Verifiable releases.</strong> Build provenance attestations and an SBOM on every release.</li>
					<li><strong>Checked continuously.</strong> Fuzzed parsers, cargo-deny, CI pinned to commits, an <a href="https://scorecard.dev/viewer/?uri=github.com/nahuel11500/recouvrance">OpenSSF Scorecard</a>.</li>
				</ul>
			</section>

			{
				releases.length > 0 && (
					<section class="wrap">
						<p class="kicker">Shipping often</p>
						<h2>Latest releases</h2>
						<ol class="releases">
							{releases.map((r) => (
								<li>
									<a class="tag" href={r.url}>{r.tag}</a>
									<FormattedDate date={r.date} />
									<ul>
										{r.highlights.map((h) => (
											<li set:html={h} />
										))}
									</ul>
								</li>
							))}
						</ol>
						<p><a href={`${GITHUB}/blob/main/CHANGELOG.md`}>Full changelog →</a></p>
					</section>
				)
			}

			<section class="wrap faq">
				<p class="kicker">Questions</p>
				<h2>Questions, answered</h2>
				{
					faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p set:html={f.a} />
						</details>
					))
				}
			</section>

			<section class="hero closing">
				<h2>Try it on your clusters. It starts read-only.</h2>
				<pre class="install" aria-label="Install command"><code>{INSTALL}</code></pre>
				<p class="actions">
					<a class="button primary" href={GITHUB}>View on GitHub</a>
					<a class="button" href={DOCS}>Read the docs</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.rv {
		--navy: #14213d;
		--navy-deep: #0c1529;
		--sea: #2c4a7c;
		--ochre: #c8913e;
		--cream: #f1e6cf;
		--allow: #1f7a4d;
		--ask: #a86a12;
		--deny: #c0392b;
		width: auto;
		max-width: none;
		padding: 0;
		font-size: 18px;
	}
	.wrap {
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 4em 0 0;
	}
	h2 {
		font-size: 2em;
		margin-bottom: 0.6em;
	}
	h3 {
		font-size: 1.1em;
		margin: 0.2em 0 0.3em;
	}
	.kicker {
		margin: 0 0 0.4em;
		color: var(--sea);
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* Hero */
	.hero {
		padding: 3.5em 1em 9em;
		background: radial-gradient(ellipse at top, var(--sea), var(--navy) 55%, var(--navy-deep));
		color: var(--cream);
		text-align: center;
	}
	.logo {
		display: block;
		margin: 0 auto 1em;
		border-radius: 20px;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
	}
	.eyebrow {
		margin: 0 0 0.6em;
		color: var(--ochre);
		font-weight: 700;
		letter-spacing: 0.05em;
	}
	.eyebrow span {
		color: rgba(241, 230, 207, 0.6);
		font-weight: 400;
	}
	.hero h1 {
		color: #fff;
		font-size: 3em;
		line-height: 1.1;
		margin-bottom: 0.4em;
	}
	.hero h1 span {
		color: var(--ochre);
	}
	.lede {
		max-width: 38em;
		margin: 0 auto 1.6em;
		font-size: 1.1em;
		color: rgba(241, 230, 207, 0.9);
	}
	.install {
		max-width: 46em;
		margin: 0 auto 1.4em;
		padding: 0.9em 1.2em;
		background: rgba(0, 0, 0, 0.35);
		border: 1px solid rgba(241, 230, 207, 0.15);
		border-radius: 10px;
		color: var(--cream);
		font: 0.78em/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		text-align: left;
		white-space: pre-wrap;
		word-break: break-all;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75em;
		margin: 0 0 1em;
	}
	.button {
		padding: 0.55em 1.3em;
		border: 1px solid rgba(241, 230, 207, 0.4);
		border-radius: 8px;
		color: var(--cream);
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		color: #fff;
		border-color: var(--cream);
	}
	.button.primary {
		background: var(--ochre);
		border-color: var(--ochre);
		color: var(--navy-deep);
	}
	.button.primary:hover {
		background: #d9a252;
		color: var(--navy-deep);
	}
	.meta {
		margin: 0;
		font-size: 0.85em;
		color: rgba(241, 230, 207, 0.65);
	}
	.window {
		width: 1080px;
		max-width: calc(100% - 2em);
		margin: -7em auto 0;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 24px 60px rgba(12, 21, 41, 0.35);
		background: var(--navy-deep);
		line-height: 0;
	}
	.window video {
		width: 100%;
		height: auto;
	}

	/* Agents */
	.agents {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 2.5em;
		align-items: center;
	}
	.checks {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.checks li {
		position: relative;
		padding-left: 1.6em;
		margin-bottom: 0.7em;
	}
	.checks li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--ochre);
		font-weight: 700;
	}
	.rules {
		margin: 0;
		padding: 1.2em;
		background: var(--navy);
		border-radius: 12px;
		color: var(--cream);
		box-shadow: 0 12px 40px rgba(12, 21, 41, 0.25);
		overflow-x: auto;
	}
	.rules table {
		border-collapse: collapse;
		font: 0.72em/1.4 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	}
	.rules th {
		color: rgba(241, 230, 207, 0.55);
		font-weight: 400;
		text-align: left;
	}
	.rules th,
	.rules td {
		padding: 0.5em 0.55em;
		border-bottom: 1px solid rgba(241, 230, 207, 0.1);
		white-space: nowrap;
	}
	.rules td span {
		padding: 0.1em 0.5em;
		border-radius: 4px;
		color: #fff;
		font-weight: 700;
	}
	.allow {
		background: var(--allow);
	}
	.ask {
		background: var(--ask);
	}
	.deny {
		background: var(--deny);
	}
	.rules figcaption {
		margin-top: 0.9em;
		font-size: 0.8em;
		color: rgba(241, 230, 207, 0.75);
	}
	.story {
		grid-column: 1 / -1;
		padding: 1em 1.4em;
		border-left: 4px solid var(--ochre);
		background: rgba(200, 145, 62, 0.08);
		border-radius: 0 8px 8px 0;
	}
	.story p {
		margin: 0;
	}

	/* Cards */
	.shots,
	.features {
		display: grid;
		gap: 1.2em;
	}
	.shots {
		grid-template-columns: 1fr 1fr;
	}
	.features {
		grid-template-columns: repeat(3, 1fr);
		margin-top: 1.2em;
	}
	.card {
		padding: 1.2em 1.3em;
		background: #fff;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
	}
	.card p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.92em;
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 0.8em;
		border-radius: 8px;
		border: 1px solid rgb(var(--gray-light));
	}

	/* Numbers */
	.numbers {
		margin-top: 4em;
		padding-bottom: 4em;
		background: var(--navy);
		color: var(--cream);
	}
	.numbers h2 {
		color: #fff;
	}
	.numbers .kicker {
		color: var(--ochre);
	}
	.numbers dl {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5em;
		margin: 1.5em 0 0;
	}
	.numbers dt {
		color: #fff;
		font-size: 2.6em;
		font-weight: 700;
		line-height: 1.1;
	}
	.numbers dd {
		margin: 0.3em 0 0;
		color: rgba(241, 230, 207, 0.75);
		font-size: 0.9em;
	}
	.numbers code {
		background: rgba(255, 255, 255, 0.12);
		color: var(--cream);
	}

	/* Trust */
	.two {
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: 2.5em;
	}

	/* Releases */
	.releases {
		list-style: none;
		padding: 0;
		margin: 0 0 1em;
	}
	.releases > li {
		padding: 0.9em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.releases .tag {
		margin-right: 0.8em;
		font-weight: 700;
		text-decoration: none;
	}
	.releases ul {
		margin: 0.3em 0 0;
		padding-left: 1.2em;
		color: rgb(var(--gray-dark));
	}

	/* FAQ */
	.faq details {
		border-bottom: 1px solid rgb(var(--gray-light));
		padding: 0.9em 0;
	}
	.faq summary {
		cursor: pointer;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.faq details p {
		margin: 0.7em 0 0.3em;
		color: rgb(var(--gray-dark));
	}

	/* Closing */
	.closing {
		margin-top: 5em;
		padding: 4em 1em;
	}
	.closing h2 {
		color: #fff;
	}

	@media (max-width: 860px) {
		.agents,
		.two,
		.shots {
			grid-template-columns: 1fr;
		}
		.features {
			grid-template-columns: 1fr 1fr;
		}
		.numbers dl {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.hero h1 {
			font-size: 2.1em;
		}
		.features {
			grid-template-columns: 1fr;
		}
		.window {
			margin-top: -6em;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.window video {
			display: none;
		}
		.window {
			background: url('/media/recouvrance/tour-poster.webp') center / cover;
			aspect-ratio: 1200 / 736;
		}
	}
</style>
