---
import ProjectCard from '../../components/ProjectCard.astro';
import Site from '../../layouts/Site.astro';
import { projects } from '../../lib/projects';
---

<Site title="Projects" description="Open source tools I build, mostly for Kubernetes.">
	<h1>Projects</h1>
	<p class="intro">What I build in the open, for running Kubernetes.</p>
	<div class="list">
		{projects.map((p) => <ProjectCard project={p} />)}
	</div>
</Site>

<style>
	.list {
		display: grid;
		gap: 1.5rem;
		margin-top: 2.5rem;
	}
</style>
