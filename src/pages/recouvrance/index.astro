---
import Shot from '../../components/recouvrance/Shot.astro';
import Layout from '../../layouts/Recouvrance.astro';
import { latestReleases } from '../../lib/releases';
import { BASE, GITHUB, INSTALL, MEDIA, REPO, TOOLS, doc } from '../../lib/recouvrance';

const releases = await latestReleases(REPO, 1);
const release = releases[0];

const title = 'Recouvrance: the fast Kubernetes client, for you and your agents';
const description =
	'A native Kubernetes desktop client in Rust and gpui, the engine behind Zed. It finds what is broken, and lets AI agents help under your rules.';

const pillars = [
	{ title: 'Fast. Really.', text: 'Native Rust on gpui, the GPU engine behind Zed. No browser inside.' },
	{ title: 'Knows what is wrong', text: 'Problems across clusters, and a diagnosis on every broken pod.' },
	{ title: 'Agents, on your rules', text: 'A local MCP server with allow, ask and deny, approvals and an audit log.' },
];

const agentShots = [
	{ img: 'approval', title: 'Rules and approvals', text: 'Allow, ask or deny, like RBAC. Ask me waits for your click.', alt: "An agent's request waiting for approval above its rules", height: 981 },
	{ img: 'activity', title: 'Audit log', text: 'Every call, grouped by task, with the rule that decided it.', alt: "An agent's calls grouped by task", height: 1000 },
	{ img: 'assistant', title: 'Built-in assistant', text: 'Investigate from any broken pod, through your Claude Code.', alt: 'The assistant explaining why a pod crash-loops', height: 1000 },
];

const everyday = [
	{ img: 'logs', title: 'Logs across pods', alt: 'Logs of every pod of a deployment, merged, with levels and a histogram', height: 1000 },
	{ img: 'command-palette', title: 'Ctrl+K to anything', alt: 'The command palette finding objects and pages', height: 1000 },
	{ img: 'pods-dark', title: 'Light and dark', alt: 'The pods table in the dark theme', height: 981 },
];

const more = ['Several clusters at once', 'Helm', 'Argo CD and Flux', 'Rollbacks with diffs', 'Shell, attach, files', 'Port-forwards', 'RBAC and who-can', 'Usage history', 'Reachability', 'Upgrade check', 'Timeline', 'CRDs'];

const faq = [
	{ q: 'Is it safe to let an agent in?', a: `Agents only get what their rules allow; anything else is denied. <a href="${BASE}/agents/">How agents work</a>.` },
	{ q: 'How is it different from Lens or Headlamp?', a: `Native, no web view, it diagnoses instead of only listing, and it is built for agents. <a href="${BASE}/compare/">Comparison</a>.` },
	{ q: 'Does it send data anywhere?', a: 'No telemetry. Only your clusters, your Prometheus, and Anthropic if you use the assistant.' },
	{ q: 'Is it free?', a: 'Yes: open source, MIT or Apache-2.0. Linux and macOS; Windows not yet.' },
];
---

<Layout title={title} description={description}>
	<section class="hero">
		<div class="rv-wrap">
			{
				release && (
					<a class="badge" href={release.url}>
						<span>New</span>
						{release.tag} is out →
					</a>
				)
			}
			<h1>Kubernetes at <em>native speed</em>.<br />For you and your agents.</h1>
			<p class="lede">
				Rust and gpui, the engine behind Zed. It finds what is broken, and lets AI agents help under your rules.
			</p>
			<p class="actions">
				<a class="button primary" href={`${BASE}/download/`}>Download</a>
				<a class="button" href={GITHUB}>GitHub</a>
			</p>
			<pre class="install" title="Click to select, then copy"><code>{INSTALL}</code></pre>
			<p class="meta">Linux and macOS · Free and open source · No telemetry</p>
		</div>
		<div class="rv-wrap">
			<figure class="window">
				<picture>
					<source media="(prefers-reduced-motion: reduce)" srcset={`${MEDIA}/tour-poster.webp`} />
					<img
						src={`${MEDIA}/tour.webp`}
						width="1600"
						height="981"
						fetchpriority="high"
						alt="A tour of Recouvrance: the pods table, the command palette, a crash diagnosis, the assistant finding its cause, logs across pods, the Problems page, an agent's request waiting for approval and the dark theme"
					/>
				</picture>
			</figure>
		</div>
	</section>

	<section class="rv-wrap pillars">
		{
			pillars.map((p) => (
				<article>
					<h2>{p.title}</h2>
					<p>{p.text}</p>
				</article>
			))
		}
	</section>

	<section class="speed">
		<div class="rv-wrap">
			<p class="kicker">Native speed</p>
			<h2>No Electron. No web view. Just Rust on the GPU.</h2>
			<p class="sub">
				Built on <a href="https://github.com/zed-industries/zed/tree/main/crates/gpui">gpui</a>, the framework <a href="https://zed.dev/">Zed</a> draws its editor
				with. Tables are paged on the server, so huge clusters stay light.
			</p>
			<dl>
				<div><dt>174 MB</dt><dd>with 23,958 pods listed</dd></div>
				<div><dt>0</dt><dd>browsers inside</dd></div>
				<div><dt>0</dt><dd>lines of <code>unsafe</code> Rust</dd></div>
				<div><dt>0</dt><dd>telemetry calls</dd></div>
			</dl>
		</div>
	</section>

	<section id="features" class="section rv-wrap">
		<p class="kicker">Built for agents</p>
		<h2 class="section-title">Your agents work on your clusters. You keep the rules.</h2>
		<p class="section-lede">Connect Claude Code in one click, or any MCP client. {TOOLS} tools, every call checked.</p>
		<div class="trio">
			{
				agentShots.map((s) => (
					<article>
						<Shot name={s.img} alt={s.alt} height={s.height} sizes="(max-width: 900px) 100vw, 380px" />
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</article>
				))
			}
		</div>
		<p class="more-link"><a href={`${BASE}/agents/`}>How agents work →</a></p>
	</section>

	<section class="section rv-wrap">
		<p class="kicker">Knows what is wrong</p>
		<h2 class="section-title">What is broken, and why.</h2>
		<div class="duo">
			<article>
				<Shot name="problems" alt="The Problems page listing broken workloads" height={1000} sizes="(max-width: 900px) 100vw, 570px" />
				<h3>Problems</h3>
				<p>Crash loops, pending pods, failed jobs, across every cluster you have open.</p>
			</article>
			<article>
				<Shot name="diagnosis" alt="A crash-looping pod with its diagnosis and last output" height={1000} sizes="(max-width: 900px) 100vw, 570px" />
				<h3>Diagnosis</h3>
				<p>The crash output, the exit code, the reason. On the pod's page.</p>
			</article>
		</div>
	</section>

	<section class="section rv-wrap">
		<p class="kicker">Everything else</p>
		<h2 class="section-title">Everything you reach for, one click away.</h2>
		<div class="trio">
			{
				everyday.map((s) => (
					<article>
						<Shot name={s.img} alt={s.alt} height={s.height} sizes="(max-width: 900px) 100vw, 380px" />
						<h3>{s.title}</h3>
					</article>
				))
			}
		</div>
		<ul class="chips">
			{more.map((m) => <li>{m}</li>)}
		</ul>
		<p class="more-link"><a href={doc('features.md')}>All features →</a></p>
	</section>

	<section class="section rv-wrap">
		<p class="kicker">Safe by default</p>
		<ul class="chips strong">
			<li>Read-only until you say so</li>
			<li>Dry run before every write</li>
			<li>Protected contexts</li>
			<li>Signed, attested releases</li>
		</ul>
	</section>

	<section class="section rv-wrap faq">
		<h2 class="section-title">Questions</h2>
		{
			faq.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p set:html={f.a} />
				</details>
			))
		}
	</section>

	<section class="closing">
		<div class="rv-wrap">
			<h2>Try it. It starts read-only.</h2>
			<p class="actions">
				<a class="button primary" href={`${BASE}/download/`}>Download</a>
				<a class="button" href={GITHUB}>Star on GitHub</a>
			</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding: 4.5em 0 0;
		/* Navy down to the middle of the window (about 0.3 of its width), paper below. */
		background:
			linear-gradient(to bottom, transparent calc(100% - min(355px, 28vw)), var(--paper) 0),
			radial-gradient(ellipse 80% 60% at 50% 0%, rgba(44, 74, 124, 0.9), transparent),
			linear-gradient(var(--navy), var(--navy-deep));
		color: var(--cream);
		text-align: center;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		margin-bottom: 1.6em;
		padding: 0.25em 0.9em 0.25em 0.3em;
		border: 1px solid rgba(241, 230, 207, 0.2);
		border-radius: 999px;
		color: rgba(241, 230, 207, 0.85);
		font-size: 0.82em;
		text-decoration: none;
	}
	.badge span {
		padding: 0.05em 0.6em;
		border-radius: 999px;
		background: var(--brass);
		color: var(--navy-deep);
		font-weight: 700;
	}
	.badge:hover {
		border-color: var(--brass);
		color: #fff;
	}
	.hero h1 {
		margin: 0 auto 0.45em;
		color: #fff;
		font-size: 3.3em;
		line-height: 1.08;
	}
	.hero h1 em {
		color: var(--brass);
		font-style: normal;
	}
	.lede {
		max-width: 32em;
		margin: 0 auto 1.8em;
		color: rgba(241, 230, 207, 0.85);
		font-size: 1.12em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75em;
		margin: 0 0 1.5em;
	}
	.hero .install {
		max-width: 44em;
		margin: 0 auto 0.9em;
	}
	.meta {
		margin: 0 0 3.5em;
		color: rgba(241, 230, 207, 0.6);
		font-size: 0.85em;
	}

	.pillars {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2em;
		padding-top: 3.5em;
	}
	.pillars h2 {
		margin-bottom: 0.25em;
		font-size: 1.3em;
	}
	.pillars p {
		margin: 0;
		color: var(--muted);
	}

	.speed {
		margin-top: 5em;
		padding: 4.5em 0;
		background: linear-gradient(160deg, var(--navy), var(--navy-deep));
		color: rgba(241, 230, 207, 0.85);
	}
	.speed h2 {
		max-width: 16em;
		margin-bottom: 0.4em;
		color: #fff;
		font-size: 2.4em;
		line-height: 1.12;
	}
	.speed .sub {
		max-width: 36em;
		margin: 0;
	}
	.speed a {
		color: var(--brass);
	}
	.speed dl {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2em;
		margin: 2.5em 0 0;
	}
	.speed dt {
		color: var(--brass);
		font-size: 3em;
		font-weight: 700;
		line-height: 1;
	}
	.speed dd {
		margin: 0.4em 0 0;
		color: rgba(241, 230, 207, 0.7);
		font-size: 0.9em;
	}
	.speed code {
		background: rgba(255, 255, 255, 0.12);
		color: var(--cream);
	}

	.trio,
	.duo {
		display: grid;
		gap: 1.6em;
	}
	.trio {
		grid-template-columns: repeat(3, 1fr);
	}
	.duo {
		grid-template-columns: 1fr 1fr;
	}
	.trio h3,
	.duo h3 {
		margin: 0.9em 0 0.15em;
		font-size: 1.1em;
	}
	.trio p,
	.duo p {
		margin: 0;
		color: var(--muted);
		font-size: 0.92em;
	}
	.more-link {
		margin: 1.5em 0 0;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 2em 0 0;
		padding: 0;
		list-style: none;
	}
	.chips li {
		padding: 0.25em 0.85em;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: #fff;
		color: var(--ink);
		font-size: 0.88em;
	}
	.chips.strong {
		margin-top: 0.5em;
	}
	.chips.strong li {
		padding: 0.45em 1em;
		border-color: rgba(200, 145, 62, 0.4);
		background: rgba(200, 145, 62, 0.08);
		font-weight: 700;
	}

	.faq details {
		max-width: 46em;
		padding: 0.9em 0;
		border-bottom: 1px solid var(--line);
	}
	.faq summary {
		cursor: pointer;
		font-weight: 700;
	}
	.faq details p {
		margin: 0.5em 0 0.2em;
		color: var(--muted);
	}

	.closing {
		margin-top: 5em;
		padding: 4em 0;
		background: radial-gradient(ellipse at top, var(--sea), var(--navy) 60%, var(--navy-deep));
		text-align: center;
	}
	.closing h2 {
		margin-bottom: 1em;
		color: #fff;
		font-size: 2.2em;
	}

	@media (max-width: 900px) {
		.pillars,
		.trio,
		.duo {
			grid-template-columns: 1fr;
		}
		.speed dl {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.hero h1 {
			font-size: 2.2em;
		}
		.speed h2 {
			font-size: 1.8em;
		}
	}
</style>
