---
import FormattedDate from '../../components/FormattedDate.astro';
import Shot from '../../components/recouvrance/Shot.astro';
import Layout from '../../layouts/Recouvrance.astro';
import { latestReleases } from '../../lib/releases';
import { BASE, CHANGELOG, GITHUB, INSTALL, MEDIA, REPO, TOOLS, doc } from '../../lib/recouvrance';

const releases = await latestReleases(REPO);
const version = releases[0]?.tag;

const title = 'Recouvrance: the Kubernetes client that tells you what is wrong';
const description =
	'A fast, native Kubernetes desktop client in Rust. It finds what is broken across your clusters and why, and its local MCP server lets AI agents help under rules you set.';

// The big alternating sections, each a screenshot and what it shows.
const tour = [
	{
		img: 'problems',
		kicker: 'Problems',
		title: 'Everything that is broken, on one page',
		text: 'Crash loops, pending pods, unavailable workloads, NotReady nodes, failed jobs, firing alerts, stuck deletions and certificates about to expire, for every cluster you have open.',
		points: ['Grouped by severity, newest first', 'Across clusters, keyed by context', 'One click to the object and its diagnosis'],
		alt: 'The Problems page listing broken workloads across clusters',
	},
	{
		img: 'diagnosis',
		kicker: 'Diagnosis',
		title: 'And why it is broken',
		text: 'Every broken pod or workload explains itself: the crash output and exit code, why the scheduler refuses it, an image that will not pull, a failing probe, a volume that does not mount.',
		points: ['The last lines before the crash', 'The kubectl command to look further', 'Events, owners and history on the same page'],
		alt: 'A crash-looping pod with its diagnosis and last output',
	},
	{
		img: 'logs',
		kicker: 'Logs',
		title: 'Logs across every pod',
		text: 'All the pods of a deployment, a DaemonSet or a Service, merged in time order, each line marked with its pod, dozens of pods at once.',
		points: ['Levels, histogram and time range', 'Find with regex, readable JSON', 'Follow, previous container, download'],
		alt: 'Logs of every pod of a deployment, merged, with levels and a timeline',
	},
	{
		img: 'command-palette',
		kicker: 'Speed',
		title: 'Ctrl+K to anything, on any cluster',
		text: 'Live tables with kubectl’s own columns for every type, CRDs included, and a filter that understands them: <code>status:Running restarts&gt;3 age&lt;1h</code>.',
		points: ['Command palette across clusters', 'Saved views and searches', 'Keyboard first: ↑ ↓ Enter Esc'],
		alt: 'The command palette finding objects and pages',
	},
];

const features = [
	{ title: 'Several clusters at once', text: 'Merged tables with a Context column. Compare an object across clusters.' },
	{ title: 'Roll back anything', text: 'Deployments, StatefulSets and DaemonSets, with a diff and a server dry run.' },
	{ title: 'Helm, Flux and Argo CD', text: 'Upgrade with edited values, roll back, reconcile, sync, and see the Application behind an object.' },
	{ title: 'Usage history', text: 'From Prometheus or VictoriaMetrics, found through the API server. Used against requested.' },
	{ title: 'Shell, files, port-forwards', text: 'Exec, attach, a file browser and copy. Port-forwards are remembered and follow new pods.' },
	{ title: 'Access made clear', text: 'Who can, the effective access of a ServiceAccount, short-lived kubeconfigs.' },
	{ title: 'Reachability', text: 'Follows a request to a Service, an Ingress or an HTTPRoute and names the first step that breaks.' },
	{ title: 'Upgrade check', text: 'Removed APIs still in use, version skew, drains that would block, before you upgrade.' },
	{ title: 'Timeline', text: 'What changed on your clusters while the app watched, searchable, with diffs.' },
];

const works = ['Any Kubernetes cluster', 'Helm', 'Argo CD', 'Flux', 'Prometheus', 'VictoriaMetrics', 'Claude Code', 'Any MCP client'];

const faq = [
	{
		q: 'Is it safe to let an agent work on my clusters?',
		a: `Agents get only what their rules allow, and anything no rule matches is denied. <em>Ask me</em> rules wait for your approval in the window, every call is written to an audit log, and a kill switch cuts every agent off. More on the <a href="${BASE}/agents/">agents page</a>.`,
	},
	{
		q: 'How is it different from Lens, Headlamp or Aptakube?',
		a: `It is a native app with no web view, it tells you why things are broken instead of only listing them, and it is built for agents to work under rules, approvals and an audit log. See the <a href="${BASE}/compare/">feature-by-feature comparison</a>.`,
	},
	{
		q: 'Does it send data anywhere?',
		a: 'No telemetry, no analytics. It talks to your clusters, to the Prometheus or VictoriaMetrics you point it at, and to Anthropic only if you use the assistant.',
	},
	{
		q: 'Do I need Claude?',
		a: 'No. The client works on its own, and the MCP server works with any MCP client. The built-in assistant uses your Claude Code login, or an Anthropic API key.',
	},
	{
		q: 'Does it run on Windows?',
		a: 'Not yet. It runs on Linux (x86_64 and arm64) and macOS (Intel and Apple silicon).',
	},
	{
		q: 'Is it free?',
		a: 'Yes, and open source, under the MIT or Apache-2.0 license, your choice. No account, no sign-in.',
	},
	{
		q: 'Where does the name come from?',
		a: '<em>Recouvrance</em> is a schooner from Brest, a replica of an 1817 aviso: the fast ships that carried dispatches. In French, <em>recouvrer</em> means to recover.',
	},
];
---

<Layout title={title} description={description}>
	<section class="hero">
		<div class="rv-wrap">
			<a class="badge" href={releases[0]?.url ?? `${GITHUB}/releases`}>
				<span>New</span>
				{version ? `${version} is out` : 'Latest release'}: see what changed →
			</a>
			<h1>The Kubernetes client that tells you <em>what is wrong</em>.</h1>
			<p class="lede">
				Recouvrance is a fast, native desktop client for your clusters, written in Rust. It finds what is
				broken and explains why, and its local MCP server lets AI agents help, under rules you set.
			</p>
			<p class="actions">
				<a class="button primary" href={`${BASE}/download/`}>Download for Linux and macOS</a>
				<a class="button" href={GITHUB}>View on GitHub</a>
			</p>
			<pre class="install" aria-label="Install command"><code>{INSTALL}</code></pre>
			<p class="meta">Free and open source · No account · No telemetry · Starts read-only</p>
		</div>
		<div class="rv-wrap stage">
			<figure class="window">
				<picture>
					<source media="(prefers-reduced-motion: reduce)" srcset={`${MEDIA}/tour-poster.webp`} />
					<img
						src={`${MEDIA}/tour.webp`}
						width="1600"
						height="981"
						fetchpriority="high"
						alt="A tour of Recouvrance: the pods table, the command palette, a crash diagnosis, logs across pods, the Problems page and the workloads overview"
					/>
				</picture>
			</figure>
		</div>
	</section>

	<section class="works rv-wrap" aria-label="Works with">
		<span>Works with</span>
		<ul>
			{works.map((w) => <li>{w}</li>)}
		</ul>
	</section>

	<section id="features" class="section rv-wrap">
		<p class="kicker">Tells you what is wrong</p>
		<h2 class="section-title">Less time finding the problem, more time fixing it</h2>
		<p class="section-lede">
			Most clients list objects and leave the detective work to you. Recouvrance reads them the way you
			would, and puts the answer first.
		</p>
		{
			tour.map((t, i) => (
				<article class={`row${i % 2 ? ' flip' : ''}`}>
					<div class="copy">
						<p class="kicker">{t.kicker}</p>
						<h3>{t.title}</h3>
						<p set:html={t.text} />
						<ul class="checks">
							{t.points.map((p) => (
								<li>{p}</li>
							))}
						</ul>
					</div>
					<Shot name={t.img} alt={t.alt} />
				</article>
			))
		}
	</section>

	<section class="agents-band">
		<div class="rv-wrap split">
			<div>
				<p class="kicker">Built for agents</p>
				<h2 class="section-title">Your agents work on your clusters. You keep the rules.</h2>
				<p>
					While it runs, Recouvrance serves MCP on localhost. Connect Claude Code in one click, or any MCP
					client, and give each agent rules that read like Kubernetes RBAC, with an effect.
				</p>
				<ul class="checks">
					<li><strong>Approvals.</strong> An <em>Ask me</em> rule shows you the exact request before it runs.</li>
					<li><strong>Audit log and kill switch.</strong> Every call is logged; one switch cuts every agent off.</li>
					<li><strong>{TOOLS} tools.</strong> Logs, diffs, rollouts, port-forwards, debug containers, drain, <code>can-i</code>.</li>
				</ul>
				<p class="actions left">
					<a class="button primary" href={`${BASE}/agents/`}>How agents work</a>
				</p>
			</div>
			<figure class="rules">
				<table>
					<thead>
						<tr><th>Effect</th><th>Verbs</th><th>Resources</th><th>Namespaces</th><th>Contexts</th></tr>
					</thead>
					<tbody>
						<tr><td><span class="effect allow">Allow</span></td><td>get, list, logs</td><td>*</td><td>*</td><td>*</td></tr>
						<tr><td><span class="effect ask">Ask me</span></td><td>scale, restart</td><td>deployments</td><td>team-*</td><td>staging</td></tr>
						<tr><td><span class="effect deny">Deny</span></td><td>reveal</td><td>secrets</td><td>*</td><td>*</td></tr>
						<tr><td><span class="effect deny">Deny</span></td><td>delete, drain</td><td>*</td><td>*</td><td>prod-*</td></tr>
					</tbody>
				</table>
				<figcaption>Deny wins, then Ask me, then Allow. Anything no rule matches is denied.</figcaption>
			</figure>
		</div>
	</section>

	<section class="section rv-wrap">
		<p class="kicker">Everything in one place</p>
		<h2 class="section-title">The rest of what you reach for, one click away</h2>
		<div class="grid">
			<Shot name="workloads" alt="The workloads overview with warnings and recent restarts" sizes="(max-width: 900px) 100vw, 560px" />
			<Shot name="pods-dark" alt="The pods table in the dark theme" sizes="(max-width: 900px) 100vw, 560px" />
		</div>
		<div class="features">
			{
				features.map((f) => (
					<article>
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</article>
				))
			}
		</div>
		<p><a href={doc('features.md')}>Every feature, in the docs →</a></p>
	</section>

	<section class="numbers">
		<div class="rv-wrap">
			<p class="kicker">Native, no web view</p>
			<h2 class="section-title">Rust and gpui, the toolkit behind the Zed editor</h2>
			<dl>
				<div><dt>174 MB</dt><dd>peak memory listing 23,958 pods of a production cluster</dd></div>
				<div><dt>{TOOLS}</dt><dd>MCP tools for agents, each checked against your rules</dd></div>
				<div><dt>0</dt><dd>telemetry or analytics calls</dd></div>
				<div><dt>0</dt><dd>lines of <code>unsafe</code> Rust: the crate forbids it</dd></div>
			</dl>
		</div>
	</section>

	<section class="section rv-wrap split">
		<div>
			<p class="kicker">Safe by default</p>
			<h2 class="section-title">It holds your credentials. It earns that.</h2>
		</div>
		<ul class="checks">
			<li><strong>Read-only until you say so.</strong> Every write shows its <code>kubectl</code> equivalent and asks first.</li>
			<li><strong>Dry run first.</strong> YAML edits and applies are checked by the API server before they land.</li>
			<li><strong>Protected contexts.</strong> Production waits a few seconds, or makes you type its name.</li>
			<li><strong>Verifiable releases.</strong> Build provenance attestations and an SBOM on every release.</li>
			<li><strong>Checked continuously.</strong> Fuzzed parsers, cargo-deny, CI pinned to commits, an <a href="https://scorecard.dev/viewer/?uri=github.com/nahuel11500/recouvrance">OpenSSF Scorecard</a>.</li>
		</ul>
	</section>

	{
		releases.length > 0 && (
			<section class="section rv-wrap">
				<p class="kicker">Shipping often</p>
				<h2 class="section-title">Latest releases</h2>
				<ol class="releases">
					{releases.map((r) => (
						<li>
							<a class="tag" href={r.url}>{r.tag}</a>
							<FormattedDate date={r.date} />
							<ul>
								{r.highlights.map((h) => (
									<li set:html={h} />
								))}
							</ul>
						</li>
					))}
				</ol>
				<p><a href={CHANGELOG}>Full changelog →</a></p>
			</section>
		)
	}

	<section class="section rv-wrap faq">
		<p class="kicker">Questions</p>
		<h2 class="section-title">Questions, answered</h2>
		{
			faq.map((f) => (
				<details>
					<summary>{f.q}</summary>
					<p set:html={f.a} />
				</details>
			))
		}
	</section>

	<section class="closing">
		<div class="rv-wrap">
			<h2>Try it on your clusters. It starts read-only.</h2>
			<p class="actions">
				<a class="button primary" href={`${BASE}/download/`}>Download</a>
				<a class="button" href={GITHUB}>Star it on GitHub</a>
			</p>
		</div>
	</section>
</Layout>

<style>
	/* Hero */
	.hero {
		padding: 4.5em 0 0;
		background:
			radial-gradient(ellipse 80% 60% at 50% 0%, rgba(44, 74, 124, 0.9), transparent),
			linear-gradient(var(--navy) 0%, var(--navy-deep) 70%, var(--paper) 70%);
		color: var(--cream);
		text-align: center;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		margin-bottom: 1.6em;
		padding: 0.25em 0.9em 0.25em 0.3em;
		border: 1px solid rgba(241, 230, 207, 0.2);
		border-radius: 999px;
		color: rgba(241, 230, 207, 0.85);
		font-size: 0.82em;
		text-decoration: none;
	}
	.badge span {
		padding: 0.05em 0.6em;
		border-radius: 999px;
		background: var(--brass);
		color: var(--navy-deep);
		font-weight: 700;
	}
	.badge:hover {
		border-color: var(--brass);
		color: #fff;
	}
	.hero h1 {
		max-width: 15em;
		margin: 0 auto 0.4em;
		color: #fff;
		font-size: 3.4em;
		line-height: 1.06;
	}
	.hero h1 em {
		color: var(--brass);
		font-style: normal;
	}
	.lede {
		max-width: 36em;
		margin: 0 auto 1.8em;
		color: rgba(241, 230, 207, 0.88);
		font-size: 1.15em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75em;
		margin: 0 0 1.5em;
	}
	.actions.left {
		justify-content: flex-start;
		margin-top: 1.5em;
	}
	.hero .install {
		max-width: 44em;
		margin: 0 auto 1em;
	}
	.meta {
		margin: 0 0 3.5em;
		color: rgba(241, 230, 207, 0.6);
		font-size: 0.85em;
	}
	.stage {
		max-width: min(1160px, calc(100% - 2.5em));
	}

	/* Works with */
	.works {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.8em 1.6em;
		padding: 2.5em 0 0;
		color: var(--muted);
		font-size: 0.88em;
	}
	.works span {
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.85em;
	}
	.works ul {
		display: contents;
		list-style: none;
	}
	.works li {
		padding: 0.2em 0.8em;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: #fff;
	}

	/* Alternating rows */
	.row {
		display: grid;
		grid-template-columns: 5fr 7fr;
		gap: 3.5em;
		align-items: center;
		margin: 4em 0 0;
	}
	.row.flip .copy {
		order: 2;
	}
	.row h3 {
		margin-bottom: 0.4em;
		font-size: 1.75em;
		line-height: 1.2;
	}
	.row .copy > p:not(.kicker) {
		color: var(--muted);
	}

	/* Agents band */
	.agents-band {
		margin-top: 6em;
		padding: 5em 0;
		background: linear-gradient(160deg, var(--navy), var(--navy-deep));
		color: rgba(241, 230, 207, 0.88);
	}
	.agents-band h2,
	.agents-band strong {
		color: #fff;
	}
	.agents-band code {
		background: rgba(255, 255, 255, 0.1);
		color: var(--cream);
	}
	.split {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 3em;
		align-items: center;
	}
	.rules {
		margin: 0;
		padding: 1.3em;
		border: 1px solid rgba(241, 230, 207, 0.12);
		border-radius: 12px;
		background: rgba(0, 0, 0, 0.25);
		overflow-x: auto;
	}
	.rules table {
		width: 100%;
		border-collapse: collapse;
		font: 0.72em/1.4 var(--mono);
	}
	.rules th {
		color: rgba(241, 230, 207, 0.55);
		font-weight: 400;
		text-align: left;
	}
	.rules th,
	.rules td {
		padding: 0.6em 0.55em;
		border-bottom: 1px solid rgba(241, 230, 207, 0.1);
		white-space: nowrap;
	}
	.rules figcaption {
		margin-top: 0.9em;
		color: rgba(241, 230, 207, 0.7);
		font-size: 0.8em;
	}

	/* Grid and features */
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5em;
		margin-top: 1em;
	}
	.features {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0;
		margin: 2.5em 0 1.5em;
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}
	.features article {
		padding: 1.4em 1.5em;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: #fff;
	}
	.features h3 {
		margin-bottom: 0.3em;
		font-size: 1.05em;
	}
	.features p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9em;
	}

	/* Numbers */
	.numbers {
		margin-top: 6em;
		padding: 4.5em 0;
		background: var(--navy);
		color: var(--cream);
	}
	.numbers h2 {
		color: #fff;
	}
	.numbers dl {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2em;
		margin: 2em 0 0;
	}
	.numbers dt {
		color: var(--brass);
		font-size: 2.8em;
		font-weight: 700;
		line-height: 1.1;
	}
	.numbers dd {
		margin: 0.3em 0 0;
		color: rgba(241, 230, 207, 0.75);
		font-size: 0.9em;
	}
	.numbers code {
		background: rgba(255, 255, 255, 0.12);
		color: var(--cream);
	}

	/* Releases */
	.releases {
		list-style: none;
		margin: 0 0 1em;
		padding: 0;
	}
	.releases > li {
		padding: 1em 0;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.92em;
	}
	.releases .tag {
		margin-right: 0.8em;
		font-weight: 700;
		text-decoration: none;
	}
	.releases ul {
		margin: 0.3em 0 0;
		padding-left: 1.2em;
		color: var(--ink);
	}

	/* FAQ */
	.faq details {
		max-width: 46em;
		padding: 1em 0;
		border-bottom: 1px solid var(--line);
	}
	.faq summary {
		cursor: pointer;
		color: var(--ink);
		font-weight: 700;
	}
	.faq details p {
		margin: 0.7em 0 0.3em;
		color: var(--muted);
	}

	/* Closing */
	.closing {
		margin-top: 6em;
		padding: 4.5em 0;
		background: radial-gradient(ellipse at top, var(--sea), var(--navy) 60%, var(--navy-deep));
		text-align: center;
	}
	.closing h2 {
		margin-bottom: 1em;
		color: #fff;
		font-size: 2.2em;
	}

	@media (max-width: 900px) {
		.row,
		.split,
		.grid {
			grid-template-columns: 1fr;
			gap: 1.8em;
		}
		.row.flip .copy {
			order: 0;
		}
		.features {
			grid-template-columns: 1fr 1fr;
		}
		.numbers dl {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.hero h1 {
			font-size: 2.3em;
		}
		.features {
			grid-template-columns: 1fr;
		}
		.rv-site .section-title {
			font-size: 1.8em;
		}
	}
</style>
