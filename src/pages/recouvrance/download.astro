---
import FormattedDate from '../../components/FormattedDate.astro';
import Layout from '../../layouts/Recouvrance.astro';
import { BASE, GITHUB, INSTALL, LATEST, REPO, doc, latestRelease, megabytes } from '../../lib/recouvrance';

const title = 'Download Recouvrance';
const description = 'Install Recouvrance on Linux (x86_64, arm64) or macOS (Intel, Apple silicon): one command, a tarball, a .deb or an AppImage.';

// The release's files, read at build time. Without GitHub, links go to the latest release page.
const release = await latestRelease();
const file = (match: (name: string) => boolean) => release?.assets.find((a) => match(a.name));
const download = (label: string, note: string, match: (name: string) => boolean) => {
	const a = file(match);
	return { label, note, url: a?.url ?? LATEST, size: a ? megabytes(a.size) : undefined };
};

const platforms = [
	{
		os: 'macOS',
		icon: 'apple',
		text: 'Apple silicon and Intel Macs.',
		files: [
			download('Apple silicon', 'tar.xz', (n) => n === 'recouvrance-aarch64-apple-darwin.tar.xz'),
			download('Intel', 'tar.xz', (n) => n === 'recouvrance-x86_64-apple-darwin.tar.xz'),
		],
	},
	{
		os: 'Linux x86_64',
		icon: 'linux',
		text: 'A .deb, an AppImage, or a plain tarball.',
		files: [
			download('Debian / Ubuntu', '.deb', (n) => n.endsWith('_amd64.deb')),
			download('Any distribution', 'AppImage', (n) => n === 'recouvrance-x86_64.AppImage'),
			download('Tarball', 'tar.xz', (n) => n === 'recouvrance-x86_64-unknown-linux-gnu.tar.xz'),
		],
	},
	{
		os: 'Linux arm64',
		icon: 'linux',
		text: '64-bit ARM machines.',
		files: [download('Tarball', 'tar.xz', (n) => n === 'recouvrance-aarch64-unknown-linux-gnu.tar.xz')],
	},
];
---

<Layout title={title} description={description} active="download" ogImage="/og/recouvrance/download.png">
	<section class="hero">
		<div class="rv-wrap">
			<p class="kicker">Download</p>
			<h1>Get Recouvrance</h1>
			<p class="lede">
				{
					release ? (
						<>
							<a href={release.url}>{release.tag}</a>, released <FormattedDate date={release.date} />. Free and open
							source, no account.
						</>
					) : (
						<>Free and open source, no account.</>
					)
				}
			</p>
			<div class="one">
				<p>The quickest way, on Linux and macOS:</p>
				<pre class="install" aria-label="Install command"><code>{INSTALL}</code></pre>
				<p class="small">
					It installs <code>recouvrance</code> and <code>recouvrance-update</code>, which later installs the latest
					release.
				</p>
			</div>
		</div>
	</section>

	<section class="rv-wrap platforms">
		{
			platforms.map((p) => (
				<article>
					<h2>
						{p.icon === 'apple' ? (
							<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
								<path
									fill="currentColor"
									d="M16.4 12.7c0-2.4 2-3.5 2-3.6-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.2-2.8.8-3.5.8s-1.8-.8-3-.8c-1.6 0-3 .9-3.8 2.3-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7 2-1.1 2.8-2.3c.9-1.3 1.2-2.5 1.3-2.6-.1 0-2.5-.9-2.5-3.6zM14.1 5.6c.6-.8 1.1-1.9 1-3-.9 0-2.1.6-2.7 1.4-.6.7-1.1 1.8-1 2.9 1 .1 2.1-.5 2.7-1.3z"
								/>
							</svg>
						) : (
							<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22">
								<path
									fill="currentColor"
									d="M12 2c-2 0-3.3 1.7-3.3 4.2 0 1.3.3 2.2-.4 3.4C7 11.4 5.6 13.6 5.6 16c0 .7.1 1.3.4 1.9-.9.4-1.8 1-1.8 1.8 0 1.2 2 1.5 3.4 2 .8.3 1.4.3 1.9 0 .5-.4.8-.7 2.5-.7s2 .3 2.5.7c.5.3 1.1.3 1.9 0 1.4-.5 3.4-.8 3.4-2 0-.8-.9-1.4-1.8-1.8.3-.6.4-1.2.4-1.9 0-2.4-1.4-4.6-2.7-6.4-.7-1.2-.4-2.1-.4-3.4C15.3 3.7 14 2 12 2zm-1.3 4.1c.4 0 .7.5.7 1.1s-.3 1.1-.7 1.1-.7-.5-.7-1.1.3-1.1.7-1.1zm2.6 0c.4 0 .7.5.7 1.1s-.3 1.1-.7 1.1-.7-.5-.7-1.1.3-1.1.7-1.1zM12 9.2c.9 0 1.9.6 1.9 1s-1 .9-1.9.9-1.9-.5-1.9-.9 1-1 1.9-1z"
								/>
							</svg>
						)}
						{p.os}
					</h2>
					<p class="small">{p.text}</p>
					<ul>
						{p.files.map((f) => (
							<li>
								<a class="file" href={f.url}>
									<span>
										<strong>{f.label}</strong>
										<em>{f.note}</em>
									</span>
									{f.size && <span class="size">{f.size}</span>}
								</a>
							</li>
						))}
					</ul>
				</article>
			))
		}
	</section>

	<section class="section rv-wrap notes">
		<article>
			<h2>macOS: the first launch</h2>
			<p>
				The builds aren't notarized. The install command above is not affected. A tarball downloaded with a browser is
				quarantined: the first time, run <code>xattr -d com.apple.quarantine path/to/recouvrance</code>, or allow it
				in System Settings → Privacy &amp; Security.
			</p>
		</article>
		<article>
			<h2>Check what you downloaded</h2>
			<p>
				Every tarball, <code>.deb</code> and AppImage has a build provenance attestation, which shows it was built by
				the repository's release workflow from the tagged commit:
			</p>
			<pre class="install on-paper"><code>gh attestation verify recouvrance-x86_64-unknown-linux-gnu.tar.xz --repo {REPO}</code></pre>
			<p class="small">Each release also carries the checksums and a CycloneDX SBOM of the dependencies.</p>
		</article>
		<article>
			<h2>From source</h2>
			<p>With Rust installed (on Linux, the libraries listed in the <a href={doc('development.md#build')}>build notes</a> first):</p>
			<pre class="install on-paper"><code>cargo install --locked --git {GITHUB}</code></pre>
		</article>
		<article>
			<h2>Then</h2>
			<ol>
				<li>Launch Recouvrance and pick one or more contexts from your kubeconfig.</li>
				<li>Browse with the sidebar or <strong>Ctrl+K</strong>.</li>
				<li>Click the <code>read-only</code> badge when you want to change something.</li>
				<li>In <strong>Agents</strong>, click <strong>Connect Claude Code</strong> to let Claude help, under <a href={`${BASE}/agents/`}>your rules</a>.</li>
			</ol>
		</article>
	</section>

	<section class="section rv-wrap small center">
		<p>
			Every file of every release is on <a href={`${GITHUB}/releases`}>GitHub</a>. Windows isn't supported yet.
		</p>
	</section>
</Layout>

<style>
	.hero {
		padding: 4em 0 5em;
		background: radial-gradient(ellipse 80% 70% at 50% 0%, rgba(44, 74, 124, 0.9), transparent), var(--navy-deep);
		color: var(--cream);
		text-align: center;
	}
	.hero h1 {
		margin: 0 auto 0.3em;
		color: #fff;
		font-size: 3em;
	}
	.lede {
		margin: 0 auto 2em;
		color: rgba(241, 230, 207, 0.85);
	}
	.lede a {
		color: var(--brass);
		font-weight: 700;
	}
	.one {
		max-width: 46em;
		margin: 0 auto;
	}
	.one p {
		margin: 0 0 0.7em;
	}
	.one .small {
		margin-top: 0.8em;
		color: rgba(241, 230, 207, 0.65);
	}
	.one code {
		background: rgba(255, 255, 255, 0.1);
		color: var(--cream);
	}
	.small {
		font-size: 0.86em;
	}
	.center {
		text-align: center;
		color: var(--muted);
	}

	.platforms {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2em;
		margin-top: -2.5em;
	}
	.platforms article {
		padding: 1.5em;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: #fff;
		box-shadow: 0 12px 30px -18px rgba(12, 21, 41, 0.35);
	}
	.platforms h2 {
		display: flex;
		align-items: center;
		gap: 0.45em;
		margin-bottom: 0.2em;
		font-size: 1.3em;
	}
	.platforms .small {
		margin: 0 0 1em;
		color: var(--muted);
	}
	.platforms ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.file {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: 0.5em;
		padding: 0.7em 0.9em;
		border: 1px solid var(--line);
		border-radius: 9px;
		color: var(--ink);
		text-decoration: none;
		transition: border-color 0.15s, background 0.15s;
	}
	.file:hover {
		border-color: var(--brass);
		background: rgba(200, 145, 62, 0.06);
	}
	.file em {
		margin-left: 0.5em;
		color: var(--muted);
		font-size: 0.85em;
		font-style: normal;
	}
	.size {
		color: var(--muted);
		font-size: 0.8em;
	}

	.notes {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5em 3em;
	}
	.notes h2 {
		font-size: 1.25em;
	}
	.notes p,
	.notes li {
		color: var(--muted);
	}
	.notes .install {
		margin: 0.6em 0;
	}

	@media (max-width: 900px) {
		.platforms,
		.notes {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 560px) {
		.hero h1 {
			font-size: 2.2em;
		}
	}
</style>
